# Copy to .env and fill in. Never commit .env, never prefix with NEXT_PUBLIC_.
# Build and test on testnet first; switch to mainnet only for the final real-memory run.
NETWORK=testnet
TATUM_API_KEY=
# Tatum mainnet key (used when NETWORK=mainnet or the mainnet toggle is chosen)
TATUM_API_KEY_MAINNET=
# Optional: signs wallet sessions. Falls back to MEMWAL_DELEGATE_KEY.
# SESSION_SECRET=
MEMWAL_ACCOUNT_ID=
MEMWAL_DELEGATE_KEY=
ALLOW_EXECUTE=false
# Saving decisions in production. Off by default so visitors cannot write to your Memory account.
ALLOW_WRITES=false
# "local" keeps decisions in-process instead of Walrus Memory (see scripts/dev-local.mjs).
# MEMORY_BACKEND=local
# A production deployment hides and ignores memories labelled real. Set true only on a private deployment.
# EXPOSE_PRIVATE=false
